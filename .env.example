# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
# With it, the Free Gift plays a simulated 1 s ad (the local backend accepts its "dev-token" outside production).
VITE_DEV_MODE=false

# Multiplayer: the backend room server (../Scare-your-neighbor-backend, `npm start`). Leave empty on deployed
# builds: they find a server through the Bloxity matchmaker. Put it in .env.local (gitignored) for local dev.
# VITE_SERVER_URL=ws://localhost:2567

# The slug the game is registered under on bloxity.io (matchmaker, rewarded ads, leaderboards).
# VITE_GAME_SLUG=scare-your-neighbor
